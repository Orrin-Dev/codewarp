{
  "name": "@codewarp/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Codewarp desktop app",
  "author": "Codewarp contributors",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "dist": "vite build && electron-builder --linux AppImage deb rpm",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@codewarp/core": "*",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "immutable": "^3.8.2",
    "jszip": "^3.10.1",
    "scratch-audio": "2.0.268",
    "scratch-blocks": "1.3.0",
    "scratch-l10n": "5.0.309",
    "scratch-render": "2.2.84",
    "scratch-storage": "4.1.27",
    "scratch-svg-renderer": "3.1.19",
    "scratch-vm": "file:../../packages/scratch-vm",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-node-polyfills": "^0.22.0",
    "vite-plugin-static-copy": "^2.0.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "dev.codewarp.app",
    "productName": "Codewarp",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "linux": {
      "category": "Development",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "maintainer": "Codewarp contributors"
    }
  }
}
